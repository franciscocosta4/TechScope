# Copia este ficheiro para `.env` e preenche os valores reais.
# O `.env` não deve ser commitado porque o repositório é público.

# Opção preferida: uma única string de ligação.
DATABASE_URL=

# Alternativa: variáveis separadas para a ligação à PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=techscope
PGUSER=postgres
PGPASSWORD=
