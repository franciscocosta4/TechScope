@model TechScope.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Estatísticas";

    @* var jobsByMonthJson = JsonSerializer.Serialize(Model.JobsByMonth); *@
    var tecnologiasJson = JsonSerializer.Serialize(Model.QuantityTech);
    var locationsJson = JsonSerializer.Serialize(Model.JobLocations);
}

<div class="dashboard-header">
    <h1>Visão geral</h1>
    <p class="text-muted">Análise do mercado de tecnologia português</p>
    <br />
</div>

<!-- STATS -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-number">@Model.TotalJobs.ToString("N0")</div>
        <div class="stat-label">Anúncios</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalTechnologies.ToString("N0")</div>
        <div class="stat-label">Tecnologias</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalCompanies.ToString("N0")</div>
        <div class="stat-label">Empresas</div>
    </div>
</div>


<!-- PESQUISA -->
<div class="card" style="padding: 1.5rem 2rem; margin-bottom: 2rem;">
    <h3 style="margin-bottom: 0.5rem;">Pesquisar tecnologia</h3>
    <form method="get" asp-action="Index" class="search-form">
        <input class="search-input" type="text" name="searchString" value="@Model.SearchString"
               placeholder="Ex: React, Java, Docker..." />
        <button type="submit" class="btn btn-sm">
            <i class="fa-solid fa-magnifying-glass"></i> Pesquisar
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.SearchString))
    {
        if (Model.SearchResults.Any())
        {
            <div style="margin-top: 1.5rem;">
                <h4>Resultados para “@Model.SearchString”</h4>
                <ul style="list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0;">
                    @foreach (var item in Model.SearchResults)
                    {
                        <li>
                            <a asp-controller="Technology" asp-action="Detail" asp-route-keyword="@item.Name"
                               style="display: inline-block; padding: 4px 14px; background: #1e1e20; color: #f0f0f0; text-decoration: none; border: 1px solid #2a2a2e;">
                                @item.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <p class="text-muted" style="margin-top: 1rem;">Nenhuma tecnologia encontrada para “@Model.SearchString”.</p>
        }
    }
</div>

<!-- GRÁFICOS DE LINHA (agora no topo, acima da pesquisa) -->
<div class="grid-1" style="margin-bottom: 2rem;">
    <div class="card">
        <div class="card-header">Tecnologias em alta</div>
        <div class="chart-container">
            <canvas id="grafico2"></canvas>
        </div>
    </div>
</div>
<!-- TOP  + DISTRIBUIÇÃO GEOGRÁFICA (lado a lado) -->
<div class="grid-2" style="margin-bottom: 2rem;">
    <!-- Tabela Top Tecnologias -->
    <div class="card">
        <div class="card-header">
            <span>Tecnologias mais procuradas</span>
            <span class="text-small">@Model.TopTechnologies.Count() registos</span>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tecnologia</th>
                        <th style="text-align: right;">Anúncios</th>
                    </tr>
                </thead>
                <tbody id="lista-resultados">
                    @{
                        int rank = ((Model.PageNumber - 1) * Model.PageSize) + 1;  // calcula onde vai começar o rank com base na pagina. (pagina 1-> 1, pagina 2-> 11 etc...)
                    }
                    @foreach (var item in Model.TopTechnologies)
                    {
                        <tr>
                            <td>@rank</td>
                            <td>@item.Name</td>
                            <td style="text-align: right; font-weight: 500;">@item.Count.ToString("N0")</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
        <!-- Paginação -->
        <nav>
            <ul class="pagination">
                @if (Model.PageNumber > 1)
                {
                    <li><a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                               asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Anterior</a>
                    </li>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <li><a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                               asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Seguinte</a>
                    </li>
                }
            </ul>
        </nav>
    </div>

    <!-- Gráfico de rosca (doughnut) com legenda em baixo -->
    <div class="card" style="display: flex; flex-direction: column;">
        <div class="card-header">Distribuição geográfica</div>
        <div class="chart-container" style="flex: 1;">
            <canvas id="grafico3"></canvas>
        </div>
        <!-- a legenda será renderizada pelo Chart.js em position: bottom -->
    </div>
</div>

@section Scripts {
    @*  Script que faz o autoscroll para a tabela de top tech *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const params = new URLSearchParams(window.location.search);
            const page = params.get("pageNumber");

            if (page) {
                const lista = document.getElementById("lista-resultados");

                if (lista) {
                    lista.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        // ------------------------------------------------------------
        // GRÁFICO 2 — Tecnologias em alta (linha)
        // ------------------------------------------------------------
        const meses = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
        const mesesAtuais = meses.slice(0, new Date().getMonth() + 1);
        const dadosTech = @Html.Raw(tecnologiasJson);
        const techNames = [...new Set(dadosTech.map(x => x.Tecnologia))];
        const cores = ['#ffffff', '#7a7a7e', '#4a4a4e', '#b0b0b4', '#d0d0d4'];
        const datasetsTech = techNames.map((nome, idx) => {
        const valores = mesesAtuais.map((_, i) => {
        const mes = i + 1;
        const found = dadosTech.find(x => x.Tecnologia === nome && x.Mes === mes);
        return found ? found.Total : 0;
        });
        return {
        label: nome,
        data: valores,
        tension: 0.2,
        borderColor: cores[idx % cores.length],
        backgroundColor: 'transparent',
        pointRadius: 2,
        borderWidth: 1.5
        };
        });

        new Chart(document.getElementById('grafico2').getContext('2d'), {
        type: 'line',
        data: {
        labels: mesesAtuais,
        datasets: datasetsTech
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
        legend: { labels: { color: '#f0f0f0', boxWidth: 12, padding: 12 } }
        },
        scales: {
        y: { beginAtZero: true, grid: { color: '#1e1e20' }, ticks: { color: '#7a7a7e' } },
        x: { grid: { display: false }, ticks: { color: '#7a7a7e', maxRotation: 30 } }
        }
        }
        });

        // ------------------------------------------------------------
        // GRÁFICO 3 — Distribuição geográfica (doughnut / rosca)
        // ------------------------------------------------------------
        const dadosLoc = @Html.Raw(locationsJson);
        const labelsLoc = dadosLoc.map(x => x.Location);
        const valoresLoc = dadosLoc.map(x => x.Count);

        new Chart(document.getElementById('grafico3').getContext('2d'), {
        type: 'doughnut',
        data: {
        labels: labelsLoc,
        datasets: [{
        data: valoresLoc,
        backgroundColor: ['#ffffff', '#7a7a7e', '#4a4a4e', '#b0b0b4', '#d0d0d4', '#2a2a2e'],
        borderColor: '#0b0b0d',
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
        legend: {
        position: 'bottom',   // <-- legenda em baixo
        labels: {
        color: '#f0f0f0',
        boxWidth: 12,
        padding: 8,
        font: { size: 11 }
        }
        }
        },
        cutout: '60%'
        }
        });
    </script>
}