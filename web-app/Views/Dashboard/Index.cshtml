@model TechScope.ViewModels.DashboardViewModel

<div class="text-center">
    <h1 class="display-4">TechScope</h1>
    <p class="text-muted">Análise do mercado tecnológico</p>
</div>

<div class="stats-grid mt-4">
    <div class="stat-card">
        <div class="stat-number">@Model.TotalJobs.ToString("N0")</div>
        <div class="stat-label">Total de Anúncios</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalTechnologies.ToString("N0")</div>
        <div class="stat-label">Tecnologias Identificadas</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@Model.TotalCompanies.ToString("N0")</div>
        <div class="stat-label">Empresas</div>
    </div>
</div>

<div class="mt-5">
    <h3>Pesquisar Tecnologia</h3>

    <form method="get" asp-action="Index" class="search-form">
        <input class="search-input"
               type="text"
               name="SearchString"
               value="@Model.SearchString"
               placeholder="Ex: React, Java, Docker..." />
        <button type="submit" class="btn btn-sm">
            <i class="fa-solid fa-magnifying-glass"></i> Pesquisar
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.SearchString))
    {
        @if (Model.SearchResults.Any())
        {
            <div class="search-results">
                <h5 class="mt-4">Resultados para "@Model.SearchString"</h5>
                <ul>
                    @foreach (var item in Model.SearchResults)
                    {
                        <li>
                            <strong>@item.Name</strong>
                            <span class="text-muted">(Id: @item.Id)</span>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <p class="text-muted mt-3">Nenhuma tecnologia encontrada para "@Model.SearchString".</p>
        }
    }
</div>

<div class="mt-5">
    <h3>Top 10 Tecnologias Mais Procuradas</h3>
    @if (Model.TopTechnologies.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tecnologia</th>
                    <th>Anúncios</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rank = 1;
                }
                @foreach (var item in Model.TopTechnologies)
                {
                    <tr>
                        <td>@rank</td>
                        <td>@item.Name</td>
                        <td>@item.Count.ToString("N0")</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    }
</div>
