@model TechScope.ViewModels.TechnologyDetailViewModel
@{
    ViewData["Title"] = Model.Keyword;
}

<div style="margin-bottom: 2rem;">
    <h1>@Model.Keyword</h1>
    <p class="text-muted">@Model.TotalJobs.ToString("N0") anúncios associados</p>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">

    <!-- Tendência mensal -->
    <div class="card">
        <div class="card-header">Tendência mensal</div>
        @if (Model.MonthlyTrend.Any())
        {
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Mês</th><th style="text-align: right;">Anúncios</th></tr></thead>
                    <tbody>
                        @foreach (var trend in Model.MonthlyTrend)
                        {
                            <tr><td>@trend.Month</td><td style="text-align: right;">@trend.JobCount</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Sem dados de tendência.</p>
        }
    </div>

    <!-- Tecnologias relacionadas -->
    <div class="card">
        <div class="card-header">Tecnologias relacionadas</div>
        @if (Model.RelatedTechnologies.Any())
        {
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                @foreach (var tech in Model.RelatedTechnologies)
                {
                    <a asp-controller="Technology" asp-action="Detail" asp-route-keyword="@tech.Keyword"
                       class="badge badge-primary" style="text-decoration: none;">
                        @tech.Keyword (@tech.JobCount)
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Sem tecnologias relacionadas.</p>
        }
    </div>
</div>

<!-- Empresas -->
<div class="card" style="margin-top: 2rem;">
    <div class="card-header">Empresas que recrutam</div>
    @if (Model.TopCompanies.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr><th>Empresa</th><th>Localização</th><th style="text-align: right;">Anúncios</th></tr>
                </thead>
                <tbody>
                    @foreach (var company in Model.TopCompanies)
                    {
                        <tr>
                            <td>@company.Name</td>
                            <td>@(company.Location ?? "N/A")</td>
                            <td style="text-align: right;">@company.JobCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sem dados de empresas.</p>
    }
</div>

<!-- Anúncios recentes -->
<div class="card" style="margin-top: 2rem;">
    <div class="card-header">Anúncios recentes</div>
    @if (Model.RecentJobs.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr><th>Título</th><th>Empresa</th><th>Fonte</th><th style="text-align: right;">Data</th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.RecentJobs)
                    {
                        <tr>
                            <td><a href="@job.ExternalId" style="color: #f0f0f0; text-decoration: none;">@job.Title</a></td>
                            <td>@job.CompanyName</td>
                            <td>@job.Source</td>
                            <td style="text-align: right;">@job.DatePosted?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sem anúncios recentes.</p>
    }
</div>