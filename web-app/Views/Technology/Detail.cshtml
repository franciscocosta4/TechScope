@model TechScope.ViewModels.TechnologyDetailViewModel
@{
    ViewData["Title"] = Model.Keyword;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Technology" asp-action="Index">Tecnologias</a></li>
            <li class="breadcrumb-item active">@Model.Keyword</li>
        </ol>
    </nav>

    <h1 class="mb-4">@Model.Keyword</h1>
    <p class="text-muted">@Model.TotalJobs.ToString("N0") anúncios encontrados</p>

    <div class="row mt-4">
        <!-- Tendência mensal -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Tendência Mensal</h5>
                </div>
                <div class="card-body">
                    @if (Model.MonthlyTrend.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Mês</th>
                                    <th>Anúncios</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trend in Model.MonthlyTrend)
                                {
                                    <tr>
                                        <td>@trend.Month</td>
                                        <td>@trend.JobCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sem dados de tendência.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Tecnologias relacionadas -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Tecnologias Relacionadas</h5>
                </div>
                <div class="card-body">
                    @if (Model.RelatedTechnologies.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tech in Model.RelatedTechnologies)
                            {
                                <a asp-controller="Technology" asp-action="Detail" 
                                   asp-route-keyword="@tech.Keyword" 
                                   class="badge bg-primary text-decoration-none">
                                    @tech.Keyword (@tech.JobCount)
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sem tecnologias relacionadas.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Empresas que recrutam -->
    <div class="row mt-2">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Empresas que Recrutam</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopCompanies.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Empresa</th>
                                        <th>Localização</th>
                                        <th>Anúncios</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in Model.TopCompanies)
                                    {
                                        <tr>
                                            <td>@company.Name</td>
                                            <td>@(company.Location ?? "N/A")</td>
                                            <td>@company.JobCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sem dados de empresas.</p>
                    }
                </div>
            </div>
        </div>
    </div>
<br />
    <!-- Anúncios recentes -->
    <div class="row mt-2">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Anúncios Recentes</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentJobs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Empresa</th>
                                        <th>Fonte</th>
                                        <th>Data</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in Model.RecentJobs)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@job.ExternalId" class="text-decoration-none">@job.Title</a>
                                            </td>
                                            <td>@job.CompanyName</td>
                                            <td>@job.Source</td>
                                            <td>@job.DatePosted?.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sem anúncios recentes.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
