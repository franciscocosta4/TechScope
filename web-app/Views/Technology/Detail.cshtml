@model TechScope.ViewModels.TechnologyDetailViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Keyword;

    var relatedJson = JsonSerializer.Serialize(Model.RelatedTechChart);
}
<div style="margin-bottom: 2rem;">
    <h1>@Model.Keyword</h1>
    <p class="text-muted">@Model.TotalJobs.ToString("N0") anúncios associados</p>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">

    <!-- Tendência mensal -->
    <div class="card">
        <div class="card-header">Tendência mensal</div>


        @if (Model.MonthlyTrend.Any())
        {
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Mês</th><th style="text-align: right;">Anúncios</th><th style="text-align: right;">Vs. mês anterior</th></tr></thead>
                    @{
                        int? previousJobCount = null;
                    }
                    <tbody>
                        @foreach (var trend in Model.MonthlyTrend)
                        {
                            int? diff = @trend.JobCount - previousJobCount;
                            double? percentage = previousJobCount.HasValue && previousJobCount.Value != 0 ? ((double)diff.Value / previousJobCount.Value) * 100: null;
                            <tr>
                                <td>@trend.Month</td>
                                <td style="text-align: right;">@trend.JobCount</td>
                                @* <td style="text-align: right;">@(percentage.HasValue ? Math.Truncate(percentage.Value) + "%" : "-")</td> *@
                                <td style="text-align: right;">
                                    @if (percentage.HasValue)
                                    {
                                        if (percentage > 0)
                                        {
                                            <span>↑ @Math.Abs(Math.Truncate(percentage.Value))%  (+@diff)</span>
                                        }
                                        else if (percentage < 0)
                                        {
                                            <span>↓ @Math.Abs(Math.Truncate(percentage.Value))% (@diff)</span>
                                        }
                                        else
                                        {
                                            <span>— 0%</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>

                            // Guarda o valor actual para ser usado como "mês anterior"
                            // na próxima iteração.
                            previousJobCount = trend.JobCount;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Sem dados de tendência.</p>
        }
    </div>

    <!-- Tecnologias relacionadas -->
    <div class="card">
        <div class="card-header">Tecnologias relacionadas</div>
    <!-- Gráfico de rosca (doughnut)  -->
    <div class="chart-container">
        <canvas id="grafico3"></canvas>
    </div>
    <br />
        @if (Model.RelatedTechnologies.Any())
        {
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                @foreach (var tech in Model.RelatedTechnologies)
                {
                    <a asp-controller="Technology" asp-action="Detail" asp-route-keyword="@tech.Keyword"
                       class="badge badge-primary" style="text-decoration: none;">
                        @tech.Keyword (@tech.JobCount)
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Sem tecnologias relacionadas.</p>
        }
    </div>
</div>

<!-- Empresas -->
<div class="card" style="margin-top: 2rem;">
    <div class="card-header">Empresas que recrutam</div>
    @if (Model.TopCompanies.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr><th>Empresa</th><th>Localização</th><th style="text-align: right;">Anúncios</th></tr>
                </thead>
                <tbody>
                    @foreach (var company in Model.TopCompanies)
                    {
                        <tr>
                            <td>@company.Name</td>
                            <td>@(company.Location ?? "N/A")</td>
                            <td style="text-align: right;">@company.JobCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sem dados de empresas.</p>
    }
</div>

<!-- Anúncios recentes -->
<div class="card" style="margin-top: 2rem;">
    <div class="card-header">Anúncios recentes</div>
    @if (Model.RecentJobs.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr><th>Título</th><th>Empresa</th><th>Fonte</th><th style="text-align: right;">Data</th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.RecentJobs)
                    {
                        <tr>
                            <td><a href="@job.ExternalId" style="color: #f0f0f0;">@job.Title</a></td>
                            <td>@job.CompanyName</td>
                            <td>@job.Source</td>
                            <td style="text-align: right;">@job.DatePosted?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sem anúncios recentes.</p>
    }
</div>

@section Scripts {
    @*  Script que faz o autoscroll para a tabela de top tech *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const params = new URLSearchParams(window.location.search);
            const page = params.get("pageNumber");

            if (page) {
                const lista = document.getElementById("lista-resultados");

                if (lista) {
                    lista.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }
        });
    </script>
    <script>
        // função dedicada a carregar o charts.js, assim podemos fazer lazy loading dos charts
        function loadScript(src) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = src;
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        async function initCharts() {
            // Carregar Chart.js apenas se existirem gráficos na página
            if (document.getElementById('grafico3')) {
                await loadScript('https://cdn.jsdelivr.net/npm/chart.js');
                initChart3();
            }
        }

        window.addEventListener('load', initCharts);
    </script>

<script>
    // ------------------------------------------------------------
    // GRÁFICO 3 — Distribuição geográfica (doughnut / rosca)
    // ------------------------------------------------------------
    function initChart3() {
    const dadosTech = @Html.Raw(relatedJson);
    const labelsTech = dadosTech.map(x => x.Keyword);
    const valoresTech = dadosTech.map(x => x.JobCount);

    new Chart(document.getElementById('grafico3').getContext('2d'), {
        type: 'pie',

        data: {
            labels: labelsTech,

            datasets: [{
                data: valoresTech,

                backgroundColor: [
                    '#ffffff',
                    '#7a7a7e',
                    '#4a4a4e',
                    '#b0b0b4',
                    '#d0d0d4',
                    '#2a2a2e'
                ],

                borderColor: '#0b0b0d',
                borderWidth: 2
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: true,

            plugins: {
                legend: {
                    display: false
                }
            },

            cutout: '60%'
        }
    });
    }
</script>
}