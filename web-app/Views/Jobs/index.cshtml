@model TechScope.ViewModels.JobsViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Estatísticas";

    var jobsByDay = JsonSerializer.Serialize(Model.JobsByDay);
}


<div class="dashboard-header">
    <h1>Anúncios</h1>
    <p class="text-muted">@Model.TotalJobs.ToString("N0") anúncios registados</p>
</div>
<br />
<div class="card" style="padding: 1.5rem 2rem;">
    <form method="get" asp-action="Index" class="search-form"
          style="display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem;">
        <div style="display: flex; gap: 0.5rem; align-items: center; width: 100%;">
            <input class="search-input" type="text" name="searchString" value="@Model.SearchString"
                   placeholder="Pesquisar vaga (ex: Web developer...)" />
            <button type="submit" class="btn btn-sm">
                <i class="fa-solid fa-magnifying-glass"></i> Pesquisar
            </button>
        </div>
        <div style="display: flex; flex-direction: line; align-items: flex-start; gap: 1.5rem;">
            <select name="Seniority" class="form-select" style="
                background-color: #141416;
                color: #f0f0f0;
                border: 1px solid #1e1e20;
                border-radius: 0;
                padding: 10px 12px;
                font-size: 0.9rem;
                cursor: pointer;
                ">
                <option value="">Todos os níveis de Experiencia</option>

                <option value="senior" selected="@(Model.Seniority == "senior")">
                    senior
                </option>

                <option value="mid" selected="@(Model.Seniority == "mid")">
                    mid
                </option>

                <option value="junior" selected="@(Model.Seniority == "junior")">
                    junior
                </option>
            </select>
            <select name="WorkModel" class="form-select" style="
                background-color: #141416;
                color: #f0f0f0;
                border: 1px solid #1e1e20;
                border-radius: 0;
                padding: 10px 12px;
                font-size: 0.9rem;
                cursor: pointer;
                ">
                <option value="">Todos os modelos de trabalho</option>

                <option value="onsite" selected="@(Model.WorkModel == "onsite")">
                    Presencial
                </option>

                <option value="remote" selected="@(Model.WorkModel == "remote")">
                    Remoto
                </option>

                <option value="hybrid" selected="@(Model.WorkModel == "hybrid")">
                    Híbrido 
                </option>
            </select>
            <div class="location-dropdown" id="locationDropdown">
            <button type="button" class="location-dropdown-button" id="locationDropdownButton">
                <span id="locationDropdownText">Todas as localizações</span>
                <span class="location-dropdown-arrow">▼</span>
            </button>
            <div class="location-dropdown-menu" id="locationDropdownMenu">

                @foreach (var location in Model.JobLocations)
                {
                    <label class="location-option">
                        <input type="checkbox"
                            name="Locations"
                            value="@location"
                            @(Model.Locations.Contains(location) ? "checked" : "") />

                        <span>@location</span>
                    </label>
                }

            </div>
        </div>
        </div>
        <div style="margin-top: 0.2rem; font-size: 0.85rem; color: #a0a0a4;">
            <strong>Nota:</strong> A filtragem é baseada em <em>matching</em> automático no texto das descrições dos
            anúncios. Podem não corresponder realmente ao que é pedido na vaga ou não capturar todos os casos.
        </div>
        <input type="hidden" name="pageNumber" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.SearchString))
    {
        if (Model.SearchResults.Any())
        {
            <h4 style="margin: 1.5rem 0 0.5rem;">Resultados para “@Model.SearchString”</h4>
            <p class="text-muted">@Model.ResultsCounter anúncios encontrados</p>
            <div style="margin-top: 1rem;">
                @foreach (var item in Model.SearchResults)
                {
                    <div style="padding: 0.8rem 0; border-bottom: 1px solid #1e1e20;">
                        <a href="@item.ExternalId" style="color: #ffffff; font-weight: 500;">
                            @item.Title
                        </a>
                        <p style="margin: 4px 0 0; color: #7a7a7e; font-size: 0.9rem;">
                            @item.CompanyName
                        </p>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px;">
                            @foreach (var keyword in item.Keywords)
                            {
                                <span class="badge">@keyword</span>
                            }
                        </div>
                        <span class="text-small">@item.DatePosted?.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
            <!-- Paginação -->
            <nav>
                <ul class="pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <li><a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Anterior</a>
                        </li>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li><a class="page-link" asp-action="Index" asp-route-searchString="@Model.SearchString"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Seguinte</a>
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <p class="text-muted" style="margin-top: 1.5rem;">Nenhum anúncio encontrado para “@Model.SearchString”.</p>
        }
    }
</div>

    @if (string.IsNullOrWhiteSpace(Model.SearchString)) // se houverem resultados para a pesquisa escondemos isto
    {
    <!-- GRÁFICOS DE LINHA (agora no topo, acima da pesquisa) -->
    <div class="grid-1" style="margin-bottom: 2rem;">
        <div class="card">
            <div class="card-header">Evolução Diária (2026)</div>
            <div class="chart-container">
                <canvas id="grafico1"></canvas>
            </div>
        </div>
    </div>

    <!-- Últimos anúncios -->
    <div class="card">
        <div class="card-header">Últimos anúncios</div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            @foreach (var item in Model.RecentJobs)
            {
                <div>
                    <a href="@item.ExternalId" style="color: #f0f0f0;">
                        @item.Title
                    </a>
                    <span class="text-small" style="margin-left: 12px;">@item.DatePosted?.ToString("dd/MM/yyyy")</span>
                </div>
            }
        </div>
    </div>

}

@section Scripts {
    <script>
    const dropdown = document.getElementById('locationDropdown');
    const button = document.getElementById('locationDropdownButton');
    const menu = document.getElementById('locationDropdownMenu');
    const text = document.getElementById('locationDropdownText');

    // Abre/fecha o dropdown quando clicamos no botão.
    button.addEventListener('click', function () {
        dropdown.classList.toggle('open');
    });

    // Atualiza o texto apresentado no botão.
     function updateLocationText() {

        // Obtém todas as localizações seleccionadas.
        const selected = menu.querySelectorAll(
            'input[name="Locations"]:checked'
        );

        // Se nenhuma estiver seleccionada.
        if (selected.length === 0) {
            text.textContent = 'Todas as localizações';
            return;
        }

        // Obtém os nomes das localizações seleccionadas.
        const locations = Array.from(selected).map(
            checkbox => checkbox.value
        );

        // Se houver apenas uma localização.
        if (locations.length === 1) {
            text.textContent = locations[0];
            return;
        }

        // Se houver duas localizações, mostra ambas.
        if (locations.length === 2) {
            text.textContent = `${locations[0]}; ${locations[1]}`;
            return;
        }

        // Se houver mais de duas, mostra as duas primeiras + "...".
        text.textContent = `${locations[0]}; ${locations[1]}; ...`;
    }

    // Atualiza o texto sempre que uma localização é seleccionada/desseleccionada.
    menu.addEventListener('change', function () {
        updateLocationText();
    });

    // Fecha o dropdown quando clicamos fora dele.
    document.addEventListener('click', function (event) {

        if (!dropdown.contains(event.target)) {
            dropdown.classList.remove('open');
        }
    });

    // Inicializa o texto caso já existam localizações seleccionadas.
    updateLocationText();
</script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const jobsByDay = @Html.Raw(jobsByDay);

        new Chart(document.getElementById('grafico1'), {
            type: 'line',
            data: {
                labels: jobsByDay.map(x => x.Data),
                datasets: [{
                    label: 'Vagas por dia',
                    data: jobsByDay.map(x => x.Total),
                    borderColor: '#f0f0f0',
                    borderWidth: 2,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    </script>
}