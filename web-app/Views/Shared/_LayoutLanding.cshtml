<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechScope · Landing</title>

    <!-- Preconnect to font CDNs for faster loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- Font Inter with display swap -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&display=swap" rel="stylesheet">

    <!-- Font Awesome (defer loading with media="print" technique and load on demand) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" media="print" onload="this.media='all'">

    <!-- Inline critical CSS from style.css (above-the-fold only) -->
    <style>
        .app-grid { display: flex; min-height: 100vh; }
        .sidebar { position: sticky; top: 0; height: 100vh; width: 240px; border-right: 1px solid #1e1e20; padding: 2rem 1.2rem; background: #0b0b0d; flex-shrink: 0; }
        .main-content { flex: 1; padding: 2.5rem 3rem; background: #0b0b0d; }
        .card { background: #141416; border: 1px solid #1e1e20; border-radius: 0; padding: 1.6rem 2rem; margin-bottom: 2rem; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: #0b0b0d; color: #f0f0f0; line-height: 1.5; margin: 0; }
        .nav-item { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-left: 2px solid transparent; color: #7a7a7e; text-decoration: none; font-weight: 450; font-size: 0.95rem; transition: all 0.1s ease; margin-bottom: 4px; }
        .nav-item.active { background: #141416; color: #ffffff; border-left-color: #ffffff; }
        .search-input { padding: 12px 16px; background: #141416; border: 1px solid #1e1e20; color: #f0f0f0; font-size: 1rem; }
        .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; background: #ffffff; color: #0b0b0d; border: 1px solid #ffffff; font-weight: 500; font-size: 0.9rem; cursor: pointer; transition: all 0.1s ease; text-decoration: none; }
    </style>

    <!-- Defer non-critical CSS -->
    <link rel="preload" href="~/css/landing.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <script>
        /* Load style.css asynchronously */
        if (typeof localStorage !== 'undefined') {
            var css = localStorage.getItem('cached-css');
            if (css) {
                document.write(css);
            } else {
                var link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = '/css/landing.css';
                document.head.appendChild(link);
            }
        }
    </script>
    <noscript><link rel="stylesheet" href="~/css/landing.css"></noscript>
</head>
<body>
    <div class="landing">
        <div class="container">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>