<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechScope · Painel</title>

    <!-- Font Inter (Meridian usa DM Sans, mas Inter é muito próximo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&display=swap" rel="stylesheet">

    <!-- Font Awesome (ícones) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- CSS principal (substituído pelo novo estilo) -->
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <div class="app-grid">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="logo">TechScope</div>

            <nav>
                <a asp-controller="Dashboard" asp-action="Index" class="nav-item active">
                    <i class="fas fa-chart-pie"></i> Painel
                </a>
                <a asp-controller="Jobs" asp-action="Index" class="nav-item">
                    <i class="fas fa-inbox"></i> Anúncios
                </a>
                @* <a href="#" class="nav-item" onclick="return false;">
                    <i class="fas fa-trend-up"></i> Tendências
                </a> *@
            </nav>
        </div>

        <!-- MAIN -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>